#  - Quy tắc: KEY="giá trị", không có dấu cách quanh dấu "=".
#    Mỗi dòng 1 biến, ghi chú phải nằm trên dòng riêng (bắt đầu bằng #).
# =============================================================================

# ---------- 1. Thông tin sinh viên ----------
STUDENT_NAME="trannguyenhuukhanh"
STUDENT_ID="K24CNTT1"
STUDENT_CLASS="hcm-k24-cntt1"
STUDENT_EMAIL="trannguyenhuukhanh@example.com"
GITHUB_USERNAME="tranduc2601"

# ---------- 2. Thông số triển khai trên server chung ----------
# Mã đề (KHÔNG sửa)
EXAM_CODE="003"
# Cổng cá nhân trên server chung: từ 8080 trở lên, KHÔNG trùng với bạn khác
APP_PORT="9085"
# Tên project Docker Compose: <tên-viết-tắt>-de003, viết thường, ví dụ: nguyenvana-de003
COMPOSE_PROJECT_NAME="huukhanh-de003"

# ---------- 3. Cơ sở dữ liệu MySQL ----------
# Tên database (KHÔNG sửa)
MYSQL_DATABASE="ptit_task_db"
# Tài khoản ứng dụng và mật khẩu: tự đặt, không để trống
MYSQL_USER="task_user"
MYSQL_PASSWORD="task_password_123"
MYSQL_ROOT_PASSWORD="root_password_123"
